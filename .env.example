# [server]
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# [postgres]
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=your_pg_user
POSTGRES_PASSWORD=your_pg_password
POSTGRES_DATABASE=ai-lubricant
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# [redis]
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX_KEY=marsview
REDIS_DB=0
REDIS_DECODE_RESPONSES=true
REDIS_MAX_CONNECTIONS=500
REDIS_STREAM_TIMEOUT=10
REDIS_POOL_TIMEOUT=10

# [outbound] 出站上游连接池（每个出站模式实例独立生效）
OUTBOUND_CONNECTOR_LIMIT=2000
OUTBOUND_CONNECTOR_LIMIT_PER_HOST=1000

# [ai_lubricant]
AI_LUBRICANT_COMPAT_ENABLED=false
AI_LUBRICANT_USER_ADAPTER_ENABLED=false
AI_LUBRICANT_SYSTEM_USER_ID=00000000-0000-0000-0000-000000000001
AI_LUBRICANT_SYSTEM_USER_NAME=system
AI_LUBRICANT_SYSTEM_USER_EMAIL=system@ai-lubricant.local
AI_LUBRICANT_BOOTSTRAP_ADMIN_EMAIL=
AI_LUBRICANT_BOOTSTRAP_ADMIN_PASSWORD=
AI_LUBRICANT_BOOTSTRAP_ADMIN_NAME=admin
AGENT_COMPOSE_BASE_URL=
NODE_CONTROL_TOKEN=
AGENT_COMPOSE_TIMEOUT=30
NODE_CREDENTIAL_ENCRYPTION_KEY=
AGENT_COMPOSE_NODE_SERVER_PUBLIC_URL=

# Agent 附件签名临时 URL 的 HMAC 密钥（多实例必须同值）。留空时服务启动会自动
# 生成随机值并写回本文件；多实例部署务必显式配置同一密钥，否则各实例签发的
# 临时 URL 互不通过。
AGENT_ATTACHMENT_SIGNING_KEY=

# [clickhouse] 请求 payload 双写（唯一开关，默认关闭；开启后完整请求/响应体入库 ClickHouse）
CLICKHOUSE_REQUEST_PAYLOAD_ENABLED=false
CLICKHOUSE_ADDR=
CLICKHOUSE_DATABASE=ai_lubricant_logs
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_REQUEST_PAYLOAD_TTL_DAYS=30
CLICKHOUSE_MAX_PAYLOAD_BYTES=4194304

# [lan-discovery] 局域网发现：手机 App 登录页 UDP 广播 -> 服务应答登录地址。
# 详见 docs/lan-discovery.md。docker 部署时 compose 已自动设
# LAN_DISCOVERY_HTTP_PORT=<宿主映射端口>，无需手动配置。
LAN_DISCOVERY_ENABLED=true
# UDP 监听端口（手机端写死同一默认值，改动需与移动端同步重新打包）。
LAN_DISCOVERY_PORT=58160
# 响应里通告的 HTTP 端口；留空时自动取 DESKTOP_MAIN_PORT / 8001。
LAN_DISCOVERY_HTTP_PORT=
# 展示名（多台部署时可区分机器）。
LAN_DISCOVERY_SERVER_NAME=Ai Lubricant
# HTTP 仅监听 loopback（桌面默认）时发现被抑制；true 强制应答（仅本机联调）。
LAN_DISCOVERY_ALLOW_LOOPBACK=false

# [marketplace]
# 市场仓库地址（唯一必填）：owner/repo 由它解析。只能在 .env 修改，管理端不提供编辑。
MARKETPLACE_REPO_URL=
MARKETPLACE_GITHUB_BRANCH=
MARKETPLACE_GITHUB_TOKEN=
MARKETPLACE_MODULES=mcp,plugins,skills,channels,prompts,node-versions,mobile-versions,device-control-versions
MARKETPLACE_INDEX_NAME=index.json

# [marketplace.consumer]
MARKETPLACE_CONSUMER_REPO_URL=
MARKETPLACE_CONSUMER_GITHUB_BRANCH=
MARKETPLACE_CONSUMER_MODULES=mcp,plugins,skills,channels,prompts,node-versions,mobile-versions,device-control-versions
MARKETPLACE_CONSUMER_INDEX_NAME=index.json

# [release_repos] 程序发行独立仓库（GitHub Releases 存二进制，市场仓库只留元数据）。
# 三类程序各自推送到独立仓库的 Release（tag: node-v{版本} / mobile-v{版本} /
# device-control-v{版本}），下载直链为 Release asset 的 browser_download_url。
# 仓库地址不配时用内置默认（wuxin-gh/ai-lubricant-nodes|mobile|device-control）；
# token 不配时回落 MARKETPLACE_GITHUB_TOKEN。token 均未配置时上传会报「发行仓库未配置」。
# NODE_RELEASE_REPO_URL=https://github.com/wuxin-gh/ai-lubricant-nodes
# NODE_RELEASE_GITHUB_TOKEN=
# MOBILE_RELEASE_REPO_URL=https://github.com/wuxin-gh/ai-lubricant-mobile
# MOBILE_RELEASE_GITHUB_TOKEN=
# DEVICE_CONTROL_RELEASE_REPO_URL=https://github.com/wuxin-gh/ai-lubricant-device-control
# DEVICE_CONTROL_RELEASE_GITHUB_TOKEN=

# [compose] 仅 docker-compose.yml 使用，本地直跑无需配置。默认值见 docker-compose.yml，
# 按需取消注释修改。注意：compose 部署时上方 POSTGRES_PORT/REDIS_PORT 只影响宿主机
# 调试端口映射，服务内部固定连 postgres:5432 / redis:6379，无需修改。
# AI_LUBRICANT_HOST_PORT=3006      # 数据服务对外端口（管理端 /manager 与用户门户 /console）
# NODE_CONTROL_PUBLIC_PORT=8003    # 节点控制面对外端口
# TAG=local                        # 共享镜像 tag（ai-lubricant:<TAG>，三服务共用一次构建）
