# Ai Lubricant legacy INI template
#
# Runtime configuration now uses .env; copy .env.example to .env for new
# deployments. This file is retained only for older installations that still
# expect an INI-shaped configuration. Never commit real passwords or tokens.

[server]
host = 0.0.0.0
port = 8001

[postgres]
host = 127.0.0.1
port = 5432
user = your_pg_user
password = your_pg_password
database = ai-lubricant
pool_min_size = 1
pool_max_size = 10

[redis]
host = 127.0.0.1
port = 6379
prefix_key = marsview
db = 0
decode_responses = true
max_connections = 500
stream_timeout = 10
pool_timeout = 10

[ai_lubricant]
compat_enabled = false
user_adapter_enabled = false
system_user_id = 00000000-0000-0000-0000-000000000001
system_user_name = system
system_user_email = system@ai-lubricant.local
agent_compose_base_url =
node_control_token =
agent_compose_timeout = 30
agent_compose_node_bin_dir =
agent_compose_agent_image = ai-lubricant-node:local
node_review_image =
node_credential_encryption_key =
node_server_public_url =
bootstrap_admin_email =
bootstrap_admin_password =
bootstrap_admin_name = admin

[clickhouse]
request_payload_enabled = false
addr =
database = ai_lubricant_logs
username =
password =
request_payload_ttl_days = 30
max_payload_bytes = 4194304

[marketplace]
repo_url =
github_owner =
github_repo =
github_branch =
github_token =
modules = mcp,plugins,skills,channels,prompts,node-versions
index_name = index.json

[marketplace.consumer]
repo_url =
github_branch =
modules = mcp,plugins,skills,channels,prompts,node-versions
index_name = index.json
